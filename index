<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matinyo SaaS - Vendor Control Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 h-screen flex flex-col overflow-hidden">

    <!-- VENDOR HEADER -->
    <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="bg-purple-600 text-white p-2.5 rounded-xl font-bold flex items-center justify-center shadow-lg">
                <i class="fa-solid fa-shield-halved text-lg"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg text-white">Matinyo Global SaaS Master</h1>
                <p class="text-xs text-purple-400 font-medium">Software Vendor Administration Panel</p>
            </div>
        </div>
        <span class="text-xs bg-purple-500/10 text-purple-400 border border-purple-500/20 px-3 py-1.5 rounded-full font-semibold">
            <i class="fa-solid fa-lock mr-1.5"></i> Super-Admin Secured
        </span>
    </header>

    <!-- VENDOR MAIN DASHBOARD -->
    <main class="flex-1 p-6 overflow-y-auto max-w-7xl mx-auto w-full space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
                <p class="text-xs font-medium text-slate-400">Total Active Tenants</p>
                <h3 class="text-3xl font-bold text-white mt-1">24 Shops</h3>
            </div>
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
                <p class="text-xs font-medium text-slate-400">Total Monthly Recurring Revenue</p>
                <h3 class="text-3xl font-bold text-emerald-400 mt-1">TZS 2,400,000</h3>
            </div>
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl">
                <p class="text-xs font-medium text-slate-400">Global Cloud Status</p>
                <h3 class="text-lg font-bold text-emerald-400 mt-2 flex items-center">
                    <i class="fa-solid fa-circle text-xs mr-2 animate-pulse"></i> Fully Operational
                </h3>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-base font-bold text-white">Tenant Registry & Provisioning</h2>
                    <p class="text-xs text-slate-400">Create new tenant database nodes and manage client licenses.</p>
                </div>
                <button onclick="provisionTenant()" class="bg-purple-600 hover:bg-purple-500 text-white px-4 py-2.5 rounded-xl text-xs font-semibold transition shadow flex items-center">
                    <i class="fa-solid fa-plus mr-2"></i> Provision New Tenant
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="bg-slate-950/50 text-slate-400 border-b border-slate-800">
                            <th class="p-3.5">Tenant ID</th>
                            <th class="p-3.5">Business Name</th>
                            <th class="p-3.5">Subscription Tier</th>
                            <th class="p-3.5">Status</th>
                            <th class="p-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <tr>
                            <td class="p-3.5 font-bold text-white">mwanza-store</td>
                            <td class="p-3.5 text-slate-300">Mwanza General Wholesalers</td>
                            <td class="p-3.5 text-purple-400">Enterprise Pro</td>
                            <td class="p-3.5"><span class="bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-full font-semibold">Active</span></td>
                            <td class="p-3.5 text-right"><button onclick="alert('Managing tenant configuration...')" class="text-purple-400 font-semibold">Configure</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        function provisionTenant() {
            const id = prompt("Enter new client unique workspace code (e.g. arusha-mart):");
            if(id) alert(`Tenant '${id}' provisioned successfully! Collections created in Firestore.`);
        }
    </script>
</body>
</html>
